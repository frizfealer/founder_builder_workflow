stateDiagram-v2
    classDef p0 fill:#dbeafe
    classDef p1 fill:#fde68a
    classDef p2 fill:#bbf7d0
    state "Start" as s0
    state "Before the yes" as g0 {
        s1: Visitor asked
        s3: Asked for a party size
        s2: Holding a table
        s5: Proposal waiting for yes
    }
    class s1,s3,s2,s5 p0
    state "After the yes" as g1 {
        s7: Booking
        s8: Releasing the hold
    }
    class s7,s8 p1
    state "Conversation over" as g2 {
        s9: Booked, visitor told
        s6: Nothing booked, visitor told
        s10: Booking unknown, visitor told
        s4: Visitor left
    }
    class s9,s6,s10,s4 p2
    [*] --> s0
    s0 --> s1: A1 - starting situation
    s1 --> s2: A2 - visitor asks for a table for 8 or fewer
    s1 --> s3: A3 - agent tells the visitor - the largest party is 8 people, and asks for a new party size
    s2 --> s5: A4 - agent proposes the table and asks for a yes
    s2 --> s6: A5 - agent tells the visitor what happened
    s3 --> s2: A6 - visitor gives a party of 8 or fewer
    s3 --> s4: A7 - visitor leaves
    s5 --> s4: A8 - visitor leaves
    s5 --> s7: A9 - visitor says yes
    s5 --> s8: A10 - visitor changes the proposal
    s5 --> s8: A11 - visitor withdraws
    s7 --> s10: A12 - agent tells the visitor what happened
    s7 --> s2: A13 - agent holds the table again
    s7 --> s6: A14 - agent tells the visitor what happened
    s7 --> s9: A15 - agent tells the visitor what happened
    s8 --> s2: A16 - agent holds the changed table
    s8 --> s6: A17 - agent tells the visitor what happened
