stateDiagram-v2
    classDef p0 fill:#dbeafe
    classDef p1 fill:#fde68a
    classDef p2 fill:#bbf7d0
    state "Start" as s0
    state "Before the yes" as g0 {
        s1: Customer asked
        s2: Looking up orders
        s5: Asked which order
        s3: Proposal waiting for yes
    }
    class s1,s2,s5,s3 p0
    state "After the yes" as g1 {
        s6: Cancelling
        s8: Refunding
        s11: Handing off to staff
    }
    class s6,s8,s11 p1
    state "Conversation over" as g2 {
        s10: Cancelled and refunded, customer told
        s4: Nothing changed, customer told
        s12: Handed to staff, customer told
        s13: Staff not reached, customer told
        s9: Order shipped first, customer told
        s7: Customer left
    }
    class s10,s4,s12,s13,s9,s7 p2
    [*] --> s0
    s0 --> s1: A1 - starting situation
    s1 --> s2: A2 - customer asks to cancel
    s11 --> s12: A3 - agent tells the customer what happened
    s11 --> s13: A4 - agent tells the customer what happened
    s2 --> s3: A5 - agent proposes
    s2 --> s4: A6 - agent tells the customer what happened
    s2 --> s5: A7 - agent asks which order, naming each open order's number
    s3 --> s4: A8 - agent tells the customer what happened
    s3 --> s6: A9 - customer says yes
    s3 --> s7: A10 - customer leaves
    s5 --> s2: A11 - customer names one of the open orders
    s5 --> s7: A12 - customer leaves
    s6 --> s11: A13 - agent hands the case to staff
    s6 --> s4: A14 - agent tells the customer what happened
    s6 --> s8: A15 - agent issues the refund
    s6 --> s9: A16 - agent tells the customer what happened
    s8 --> s10: A17 - agent tells the customer what happened
    s8 --> s11: A18 - agent hands the case to staff
