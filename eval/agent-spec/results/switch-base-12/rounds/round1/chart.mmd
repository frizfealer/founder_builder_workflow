stateDiagram-v2
    classDef p0 fill:#dbeafe
    classDef p1 fill:#fde68a
    classDef p2 fill:#bbf7d0
    state "Start" as s0
    state "Before the yes" as g0 {
        s1: Customer asked
        s2: Looking up orders
        s6: Asked which order
        s5: Asked about the whole order
        s3: Proposal waiting for yes
    }
    class s1,s2,s6,s5,s3 p0
    state "After the yes" as g1 {
        s7: Cancelling
        s9: Refunding
        s11: Handing to staff
    }
    class s7,s9,s11 p1
    state "Conversation over" as g2 {
        s10: Cancelled and refunded, customer told
        s4: Nothing changed, customer told
        s12: Handed to staff, customer told
        s8: Customer left
    }
    class s10,s4,s12,s8 p2
    [*] --> s0
    s0 --> s1: A1 - starting situation
    s1 --> s2: A2 - customer asks to cancel
    s11 --> s12: A3 - agent tells the customer what happened
    s2 --> s3: A4 - agent proposes cancelling the order and refunding its total paid to its payment method (+1 more)
    s2 --> s4: A5 - agent tells the customer what happened
    s2 --> s5: A6 - agent tells the customer only the whole order can be cancelled
    s2 --> s6: A7 - agent asks which order to cancel
    s3 --> s2: A8 - customer says no
    s3 --> s2: A9 - customer changes the proposal
    s3 --> s7: A10 - customer says yes
    s3 --> s8: A11 - customer leaves
    s5 --> s2: A12 - customer asks to cancel the whole order
    s5 --> s8: A13 - customer leaves
    s6 --> s2: A14 - customer names the order to cancel
    s6 --> s8: A15 - customer leaves
    s7 --> s11: A16 - agent creates a follow-up task - cancellation unknown
    s7 --> s4: A17 - agent tells the customer what happened
    s7 --> s9: A18 - agent sends the refund call
    s9 --> s10: A19 - agent tells the customer what happened
    s9 --> s11: A20 - agent creates a follow-up task - refund status unknown (+2 more)
