stateDiagram-v2
    classDef p0 fill:#dbeafe
    classDef p1 fill:#fde68a
    classDef p2 fill:#bbf7d0
    state "Start" as s0
    state "Before the yes" as g0 {
        s1: Customer asked
        s2: Looking up the orders
        s6: Asked which order
        s4: Told only whole orders
        s3: Proposal waiting for yes
    }
    class s1,s2,s6,s4,s3 p0
    state "After the yes" as g1 {
        s7: Cancelling
        s9: Refunding
        s11: Handing to staff
    }
    class s7,s9,s11 p1
    state "Conversation over" as g2 {
        s10: Cancelled and refunded, customer told
        s5: Nothing changed, customer told
        s12: Handed to staff, customer told
        s13: Staff not reached, customer told
        s8: Customer left
    }
    class s10,s5,s12,s13,s8 p2
    [*] --> s0
    s0 --> s1: A1 - starting situation
    s1 --> s2: A2 - customer asks to cancel
    s11 --> s12: A3 - agent tells the customer what happened
    s11 --> s13: A4 - agent tells the customer what happened
    s2 --> s3: A5 - agent proposes - cancel this order and refund its total paid to the payment method it was paid with, asks for a yes (+1 more)
    s2 --> s4: A6 - agent tells the customer - only the whole order can be cancelled
    s2 --> s5: A7 - agent tells the customer what happened
    s2 --> s6: A8 - agent lists the orders that have not shipped and asks which one
    s3 --> s2: A9 - customer declines
    s3 --> s2: A10 - customer switches orders
    s3 --> s7: A11 - customer says yes
    s3 --> s8: A12 - customer leaves
    s4 --> s2: A13 - customer asks to cancel the whole order
    s4 --> s8: A14 - customer leaves
    s6 --> s2: A15 - customer names one of the orders
    s6 --> s8: A16 - customer leaves
    s7 --> s11: A17 - agent creates a staff follow-up task - cancellation unknown
    s7 --> s5: A18 - agent tells the customer what happened
    s7 --> s9: A19 - cancel call answers cancelled (+1 more)
    s9 --> s10: A20 - agent tells the customer what happened
    s9 --> s11: A21 - agent creates a staff follow-up task - refund status unknown (+1 more)
