stateDiagram-v2
    classDef p0 fill:#dbeafe
    classDef p1 fill:#fde68a
    classDef p2 fill:#bbf7d0
    classDef p3 fill:#fbcfe8
    state "Start" as s0
    state "Finding the order" as g0 {
        s1: Customer asked
        s2: Looking up orders
        s5: Asked which order
    }
    class s1,s2,s5 p0
    state "Before the yes" as g1 {
        s3: Proposal waiting for yes
    }
    class s3 p1
    state "After the yes" as g2 {
        s7: Cancelling
        s8: Refunding
        s9: Handing to staff
    }
    class s7,s8,s9 p2
    state "Conversation over" as g3 {
        s10: Cancelled and refunded, customer told
        s4: Nothing changed, customer told
        s11: Outcome unclear, staff will follow up
        s6: Customer left
    }
    class s10,s4,s11,s6 p3
    [*] --> s0
    s0 --> s1: A1 - starting situation
    s1 --> s2: A2 - customer asks to cancel
    s2 --> s3: A3 - agent proposes - cancel this order and refund its total to its payment method, asks for a yes
    s2 --> s4: A4 - agent tells the customer what happened
    s2 --> s5: A5 - agent asks which order, by its number
    s2 --> s7: A6 - agent cancels
    s3 --> s2: A7 - customer says yes
    s3 --> s2: A8 - customer changes the proposal
    s3 --> s2: A9 - customer declines
    s3 --> s6: A10 - customer leaves
    s5 --> s2: A11 - customer names the order
    s5 --> s6: A12 - customer leaves
    s7 --> s4: A13 - agent tells the customer what happened
    s7 --> s8: A14 - agent refunds
    s7 --> s9: A15 - agent hands to staff
    s8 --> s10: A16 - agent tells the customer what happened
    s8 --> s9: A17 - agent hands to staff
    s9 --> s11: A18 - agent tells the customer what happened
