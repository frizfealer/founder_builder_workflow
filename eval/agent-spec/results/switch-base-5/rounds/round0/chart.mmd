stateDiagram-v2
    classDef p0 fill:#dbeafe
    classDef p1 fill:#fde68a
    classDef p2 fill:#bbf7d0
    state "Start" as s0
    state "Before the yes" as g0 {
        s1: Customer asked
        s2: Looking up the orders
        s5: Asked which order
        s3: Proposal waiting for yes
    }
    class s1,s2,s5,s3 p0
    state "After the yes" as g1 {
        s6: Cancelling
        s8: Refunding
        s10: Handing to staff
    }
    class s6,s8,s10 p1
    state "Conversation over" as g2 {
        s9: Cancelled and refunded, customer told
        s4: Nothing changed, customer told
        s11: Not settled, handed to staff, customer told
        s7: Customer left
    }
    class s9,s4,s11,s7 p2
    [*] --> s0
    s0 --> s1: A1 - starting situation
    s1 --> s2: A2 - customer asks to cancel an order
    s10 --> s11: A3 - agent tells the customer what happened
    s2 --> s3: A4 - agent proposes cancelling the order and refunding its total to the payment method it was paid with, and asks for a yes
    s2 --> s4: A5 - agent tells the customer what happened
    s2 --> s5: A6 - agent asks which of the two orders to cancel
    s3 --> s4: A7 - agent tells the customer what happened
    s3 --> s6: A8 - customer says yes
    s3 --> s7: A9 - customer leaves
    s5 --> s2: A10 - customer names one of the two orders
    s5 --> s7: A11 - customer leaves
    s6 --> s10: A12 - agent creates a staff task - cancellation unknown
    s6 --> s4: A13 - agent tells the customer what happened
    s6 --> s8: A14 - cancel call answers cancelled (+1 more)
    s8 --> s10: A15 - agent creates a staff task - refund amount differs (+2 more)
    s8 --> s9: A16 - agent tells the customer what happened
